<Window x:Class="DownloadApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เอาไว้ลงลิมบัสแปลไทยฉบับคนทำไม่เป็นหรือขี้เเกียจ โดย stlinx" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <!-- ใช้ภาพเป็นพื้นหลัง -->
            <ImageBrush ImageSource="pack://application:,,,/Screenshot 2025-04-18 015702.png" Stretch="UniformToFill" Opacity="0.4"/>
        </Grid.Background>

        <!-- แสดงเวอร์ชันในเครื่อง -->
        <TextBlock Name="VersionText" Text="x.xx.xx" FontSize="36" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,81,0,0" FontFamily="Arial Black" TextAlignment="Center" Height="39" Width="638"/>

        <!-- เวอร์ชันจาก API -->
        <TextBlock Name="ApiVersionText" Text="version ล่าสุด x.xx.xx (จาก API)" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,163,0,0" TextAlignment="Center" FontWeight="Bold" Width="436" Height="28"/>

        <!-- สถานะการตรวจสอบ -->
        <TextBlock Name="StatusText" Text="checking/outdated/updated/latest version" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="Bold" Margin="0,230,0,0"/>

        <!-- ข้อความใหม่ที่เพิ่มเข้ามา -->
        <TextBlock Name="NewText" Text="Limbus TH localization by stlinx" FontSize="40" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" Foreground="#FFEC0000" FontFamily="Comic Sans MS" FontWeight="Bold"/>

        <!-- ปุ่มติดตั้งไฟล์ -->
        <Button Content="อัพเดต/ติดตั้งไฟล์แปล" Width="226" Height="40" Background="DodgerBlue" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,307,0,0" Click="InstallFileButton_Click" FontSize="22"/>

        <!-- ปุ่มเปิดลิงก์ (ใสๆ ไม่มีขอบ) -->
        <Button Width="50" Height="50" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Click="OpenLinkButton_Click">
            <!-- ไอคอน (ที่สามารถเปลี่ยนได้) -->
        </Button>
        <Image Source="https://upload.wikimedia.org/wikipedia/commons/7/7a/Discord_logo_2021.svg" Stretch="Uniform" Margin="735,369,25,25">
            <Image.OpacityMask>
                <ImageBrush/>
            </Image.OpacityMask>
        </Image>
        <Button
    Width="50" VerticalAlignment="Bottom" Margin="0,0,20,20" Height="50" HorizontalAlignment="Right" Click="OpenLinkButton_Click" BorderBrush="Transparent">
            <Button.Background>
                <ImageBrush ImageSource="/pngimg.com - discord_PNG3.png"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
